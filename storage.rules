rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Real staff accounts only (email/password sign-in via LoginScreen),
    // matching the same check used in firestore.rules.
    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Blog cover images and inline article photos. Publicly readable since
    // they're embedded on the public /blog pages; only staff can upload, and
    // each file is capped at 10MB.
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && request.resource.size < 10 * 1024 * 1024;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
