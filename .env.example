# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated list of frontend origins allowed to call this
# API (CORS). Include your Firebase Hosting domain(s), e.g.:
# ALLOWED_ORIGINS="https://nok-os-prod.web.app,https://nok-os-prod.firebaseapp.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Firebase Admin SDK service account credentials, used server-side to verify
# staff login sessions and to validate calendar-review share tokens.
# Generate via Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID="nok-os-prod"
FIREBASE_CLIENT_EMAIL="MY_SERVICE_ACCOUNT_EMAIL"
# Paste the full private key, keeping the \n escape sequences from the downloaded JSON as-is.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMY_KEY\n-----END PRIVATE KEY-----\n"

# VITE_API_URL: Read at frontend BUILD time (Vite), not by the server. Set this
# to your deployed backend's origin (e.g. Render service URL) before running
# `npm run build` for Firebase Hosting. Leave empty for local same-origin dev.
VITE_API_URL="https://your-service.onrender.com"

