{
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/home",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/home.html",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/website-builds",
          "destination": "/services/websites",
          "type": 301
        },
        {
          "source": "/website-builds.html",
          "destination": "/services/websites",
          "type": 301
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.map",
        "**/README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/app.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/images/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        }
      ]
    },
    {
      "target": "old",
      "public": "redirect-stub",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://noksocial.com",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
